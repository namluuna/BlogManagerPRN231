@model CLIENT.Models.BlogPostViewModel

@{
    ViewData["Title"] = "Xóa bài viết";
}

<h2>Bạn có chắc muốn xóa bài viết này?</h2>

<p><b>Tiêu đề:</b> @Model.Title</p>
<p><b>Nội dung:</b> @Model.Content</p>

<form method="post">
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy</a>
</form>
