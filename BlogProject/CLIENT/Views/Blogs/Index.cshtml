@model List<CLIENT.Models.BlogPostViewModel>

@{
    ViewData["Title"] = "Danh sách Blog";
}

<h2>Danh sách Blog</h2>

<form method="get">
    <input type="text" name="search" placeholder="Tìm kiếm theo tiêu đề" />
    <button type="submit">Tìm kiếm</button>
</form>

<a href="@Url.Action("Create")" class="btn btn-primary">Tạo bài viết mới</a>

<table class="table">
    <thead>
        <tr>
            <th>Tiêu đề</th>
            <th>Nội dung</th>
            <th>Ngày cập nhật</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var post in Model)
        {
            <tr>
                <td>@post.Title</td>
                <td>@post.Content</td>
                <td>@post.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = post.Id })" class="btn btn-warning">Sửa</a>
                    <a href="@Url.Action("Delete", new { id = post.Id })" class="btn btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
