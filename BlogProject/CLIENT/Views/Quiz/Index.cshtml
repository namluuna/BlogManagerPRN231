<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🧠 Đố Vui Kiến Thức</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        body {
            background-color: #f8f9fa;
            text-align: center;
            margin: 0;
            padding: 0;
        }

        .container-custom {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            padding: 0 15px;
        }

        .trivia-card {
            background: white;
            border-radius: 10px;
            padding: 20px;
            width: 100%;
            max-width: 600px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
            text-align: center;
        }

        .answer-btn {
            width: 100%;
            text-align: center;
            display: block;
            margin: 5px auto;
        }

        .result {
            font-weight: bold;
            font-size: 1.2rem;
        }
    </style>
</head>
<body>

    <div class="container-custom">
        <!-- Title -->
        <h2 class="text-center text-primary mb-4">🧠 Đố Vui Kiến Thức</h2>

        <!-- Button to load trivia -->
        <button id="getTrivia" class="btn btn-primary mb-3">🎲 Lấy Câu Hỏi Mới</button>

        <!-- Trivia content will be loaded here -->
        <div id="triviaContainer"></div>
    </div>

    <script>
        $(document).ready(function(){
            function loadTrivia() {
                $.ajax({
                    url: "https://opentdb.com/api.php?amount=3&type=multiple",
                    method: "GET",
                    success: function(response) {
                        let questions = response.results;
                        let triviaHtml = questions.map((q, index) => {
                            let answers = [...q.incorrect_answers, q.correct_answer];
                            answers = answers.sort(() => Math.random() - 0.5);

                            let answersHtml = answers.map(answer =>
                                `<button class="btn btn-outline-dark answer-btn"
                                    data-answer="${answer}" data-correct="${q.correct_answer}">
                                    ${answer}
                                </button>`
                            ).join("");

                            return `
                                <div class="trivia-card">
                                    <h5 class="text-primary">Câu ${index + 1}:</h5>
                                    <p>${q.question}</p>
                                    <div>${answersHtml}</div>
                                    <p class="result mt-3"></p>
                                </div>
                            `;
                        }).join("");
                        $("#triviaContainer").html(triviaHtml);
                    },
                    error: function() {
                        $("#triviaContainer").html("<p class='text-danger'>Lỗi khi tải câu hỏi!</p>");
                    }
                });
            }

            $("#getTrivia").click(loadTrivia);
            loadTrivia();
            loadAd("banner", { width: 728, height: 90 });
            loadAd("sidebar", { width: 300, height: 600 });
            loadAd("popup", { width: 800, height: 600 });
            loadAd("full-screen", { width: 500, height: 300 });
            $(document).on("click", ".answer-btn", function() {
                let userAnswer = $(this).data("answer");
                let correctAnswer = $(this).data("correct");
                let resultText = userAnswer === correctAnswer
                    ? "<span class='text-success'>✅ Chính xác!</span>"
                    : `<span class='text-danger'>❌ Sai! Đáp án đúng là: <strong>${correctAnswer}</strong></span>`;

                $(this).closest(".trivia-card").find(".result").html(resultText);
            });
        });
    </script>

</body>
</html>
