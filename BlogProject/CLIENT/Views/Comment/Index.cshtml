@model List<CLIENT.Models.BlogPostViewModel>

@{
    ViewData["Title"] = "Chi tiết Blog";
}

<h2>Chi tiết Blog</h2>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<form method="get">
    <input type="text" name="search" placeholder="Tìm kiếm theo tiêu đề" />
    <button type="submit">Tìm kiếm</button>
</form>
<div class="container mt-4">
    <header id="header-dashboard">
        <nav>
            <ul>
                <li><a href="/Dashboard">Dashboard</a></li>
                <li><a href="/Product">Products</a></li>
                <li><a href="/Blog">Blog</a></li>
                <li><a href="/Profile">Profile</a></li>
                <li><a id="OrderHeader" href="/Order">My Orders</a></li>
                <li><a href="#" id="logout-button">Logout</a></li>
            </ul>
        </nav>
    </header>
    <h2>Bình luận bài viết</h2>
    <div id="postTitle"></div>
    <div id="postContent"></div>

    <h3>Danh sách bình luận</h3>
    <ul id="commentsList"></ul>
    <textarea id="newCommentContent" rows="5" style="width: 100%;" placeholder="Nhập bình luận của bạn..."></textarea>
    <br>
    <button id="submitComment" style="margin-top: 10px;">Gửi bình luận</button>
</div>


<style>
    nav ul {
        list-style: none;
        padding: 0;
        display: flex;
        gap: 20px;
    }

        nav ul li {
            display: inline;
        }

            nav ul li a {
                text-decoration: none;
                font-size: 18px;
                padding: 10px;
                color: white;
                background-color: #007bff;
                border-radius: 5px;
            }

                nav ul li a:hover {
                    background-color: #0056b3;
                }
</style>


<script>
    $(document).ready(function (){
        const urlParams = new URLSearchParams(window.location.search);
        const postId = urlParams.get('postId');
        var accessToken = sessionStorage.getItem('accessToken');
        var userName = sessionStorage.getItem('userName');

        if(postId){
            loadComments(postId);
        } else {
            $("#commentsContainer").html("<p>Không tìm thấy bài viết.</p>");
        }
        $("#submitComment").click(function () {
            postComment(postId, userName);
        });


        function postComment(postId, userName){
        let commentId = $("#newCommentContent").attr("data-edit-id");
        console.log(commentId);
        if(commentId){
            let commentContent = $("#newCommentContent").val().trim();
            if(commentContent === ""){
                alert("Vui lòng nhập nội dung bình luận!");
                return;
            }
            editComment(postId, commentId, userName, commentContent);
        } else {
        let commentContent = $("#newCommentContent").val().trim();
        if (commentContent === "") {
            alert("Vui lòng nhập nội dung bình luận!");
            return;
        }
        var accessToken = sessionStorage.getItem('accessToken');
        $.ajax({
        url: `https://localhost:57954/api/Comment/comment/${postId}/${userName}/${encodeURIComponent(commentContent)}`,
        type: "POST",
        headers: { 'Authorization': 'Bearer ' + accessToken },
        success: function () {
            alert("Bình luận đã được gửi!");
            $("#newCommentContent").val("");
            loadComments(postId);
                },
        error: function (err) {
            console.log("Lỗi khi gửi bình luận: ", err);
            alert("Gửi bình luận thất bại!");
                    }
                });
            }
        }

        function deleteComment(commentId) {
        if (confirm("Bạn có chắc chắn muốn xóa bình luận này?")) {
            $.ajax({
                url: `https://localhost:57954/api/Comment/comment/${commentId}`,
                type: "DELETE",
                headers: { 'Authorization': 'Bearer ' + accessToken },
                success: function (response) {
                    alert("Xóa bình luận thành công!");
                    location.reload();
                },
                error: function (err) {
                    if (err.status === 404 && err.responseText.includes("Cannot Delete when a report exist")) {
                        alert("Không thể xóa bình luận vì có báo cáo tồn tại.");
                    } else if (err.status === 404) {
                        alert("Bình luận không tồn tại.");
                    } else {
                        console.log("Lỗi khi xóa bình luận: ", err);
                        alert("Xóa bình luận thất bại");
                        }
                    }
                });
            }   
        }
    function editComment(postId, commentId, userName, commentContent){
        console.log(postId);
        console.log(commentId);
        console.log(userName);
        console.log(commentContent);
        $.ajax({
            url: `https://localhost:57954/api/Comment/comment/${postId}/${commentId}/${userName}/${encodeURIComponent(commentContent)}`,
                type: "PUT",
                headers: { 'Authorization': 'Bearer ' + accessToken },
            success: function (response) {
                    alert("Cập nhật bình luận thành công!");
                    location.reload();
                },
                error: function (err){
                    if (err.status === 404 && err.responseText.includes("Không thể cập nhật bình luận.")) {
                        alert("Không thể cập nhật bình luận.");
                    }else if (err.status === 404) {
                        alert("Bình luận không tồn tại.");
                    }else {
                        console.log("Lỗi khi cập nhật bình luận: ", err);
                        alert("Lỗi khi cập nhật bình luận");
                        }
                }
        });
    }
    function loadComments(postId) {
        $.ajax({
            url: `https://localhost:57954/api/Comment/comment/${postId}`,
            type: "GET",
            dataType: "json",
            headers: { 'Authorization': 'Bearer ' + accessToken },
            success: function (result) {
                let userName = sessionStorage.getItem('userName');

                $("#postTitle").html(`<h3>${result.postTitle}</h3>`);
                $("#postContent").html(`<p>${result.content}</p>`);

                let commentsHtml = "";
                if (result.comments && result.comments["$values"].length > 0) {
                    result.comments["$values"].forEach(comment => {
                        let deleteButton = (userName === comment.author.username)
                            ? `<a href="#" class="btn btn-danger delete-comment" data-id="${comment.id}">Xóa bình luận</a>`
                            : "";
                        let editBtn = (userName === comment.author.username)
                        ? `<a href="#" class="btn btn-warning edit-comment" data-id="${comment.id}">Chỉnh sửa bình luận</a>` : "";
                        commentsHtml += `
                            <li>
                                <strong>${comment.author.username}</strong>
                                (<span>${comment.commentDate}</span>):
                                <p>${comment.content}</p>
                                ${deleteButton}
                                ${editBtn}
                            </li>
                        `;
                    });
                } else {
                    commentsHtml = "<li>Không có bình luận nào.</li>";
                }
                
                $("#commentsList").html(commentsHtml);
                $(".delete-comment").click(function (e) {
                e.preventDefault();
                let commentId = $(this).data("id");
                deleteComment(commentId);
                });
                $(".edit-comment").click(function (e){
                    e.preventDefault();
                    let commentId = $(this).data("id");
                    let commentContent = $(this).closest("li").find("p").text().trim();
                    $("#newCommentContent").val(commentContent);
                    $("#newCommentContent").attr("data-edit-id", commentId);
                });
            },
            error: function (err) {
                console.log("Lỗi khi tải bình luận: ", err);
                $("#commentsList").html("<li>Lỗi khi tải bình luận.</li>");
            }
        });
    }
    });
</script>