@model List<CLIENT.Models.BlogPostViewModel>

@{
    ViewData["Title"] = "Danh sách Blog";
}

<h2>Danh sách Blog</h2>

<form id="searchForm">
    <input type="text" id="searchInput" placeholder="Tìm kiếm theo tiêu đề hoặc nội dung" />
    <button type="submit">Tìm kiếm</button>
</form>


<a href="@Url.Action("Create")" class="btn btn-primary">Tạo bài viết mới</a>


<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tiêu đề</th>
            <th>Nội dung</th>
            <th>Ngày cập nhật</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody id="postsTableBody">
        <!-- Dữ liệu sẽ được thêm vào đây bằng AJAX -->
    </tbody>
</table>

<div id="postsContainer"></div>
<div id="Aaaa"></div>
<button id="prevPage">Trang Trước</button>
<span id="currentPage">Trang: 1</span>
<button id="nextPage">Trang Sau</button>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
 <script>
    function formatDate(dateString) {
        if (!dateString) return ""; // Kiểm tra nếu ngày rỗng
        let date = new Date(dateString);
        let day = String(date.getDate()).padStart(2, '0');
        let month = String(date.getMonth() + 1).padStart(2, '0'); // Tháng bắt đầu từ 0
        let year = date.getFullYear();
        return `${day}/${month}/${year}`;
    }


    $(document).ready(function (){
        let currentPage = 1;
        let pageSize = 5; // Số bài viết trên mỗi trang
        var accessToken = sessionStorage.getItem('accessToken');
        
        function loadPosts(page){
            $.ajax({
                url: `https://localhost:57954/api/Posts?page=${page}&pageSize=${pageSize}`,
                type: "GET",
                dataType: "json",
                headers: { 'Authorization': 'Bearer ' + accessToken },
                success: function (data) {
                let rows = "";
                let a = data["$values"]; // Lấy danh sách bài viết từ "$values"
                //console.log(a);
                //https://localhost:57954/api/Comment/comment/1
                a.forEach(p => {
                    console.log(`ID${p.title}`);
                    rows += `
                            <tr>
                                <td>${p.title}</td>
                                <td>${p.content}</td>
                                <td>${formatDate(p.updatedAt)}</td>
                                <td>
                                    <a href="javascript:void(0);" onclick="redirectToComments(${p.id});" class="btn btn-warning">Xem chi tiết</a>
                                    <a href="/Blog/Edit/${p.id}" class="btn btn-warning">Sửa</a>
                                    <a href="javascript:void(0);" class="btn btn-danger" onclick="deletePost(${p.id})">Xóa</a>
                                </td>
                            </tr>
                        `;
                });
                $("#postsTableBody").html(rows);
                },
                error: function () {
                    $("#postsContainer").html("<p>Lỗi khi tải bài viết.</p>");
                }
            });
        }

        loadPosts(currentPage);
        $("#searchForm").submit(function (e) {
            e.preventDefault();
            let searchKeyword = $("#searchInput").val().trim();
            loadPosts(1, searchKeyword);
        });
        $("#prevPage").click(function () {
            if (currentPage > 1) {
                currentPage--;
                loadPosts(currentPage);
            }
        });
        $("#nextPage").click(function () {
            currentPage++;
            loadPosts(currentPage);
        });
    });
    function redirectToComments(postId) {
        // Chuyển hướng đến trang /Comment/Index và truyền postId qua URL
        window.location.href = `/Comment/Index?postId=${postId}`;
    }
    //Delete
        function deletePost(postId) {
        if (!confirm("Bạn có chắc chắn muốn xóa bài viết này?")) return;

        var accessToken = sessionStorage.getItem('accessToken');

        $.ajax({
            url: `https://localhost:57954/api/Posts/${postId}`, // API DELETE
            type: "DELETE",
            headers: { 'Authorization': 'Bearer ' + accessToken },
            success: function () {
                alert("Xóa bài viết thành công!");
                location.reload();
            },
            error: function (xhr) {
                alert("Lỗi: " + xhr.responseText);
            }
        });
    }
 </script>