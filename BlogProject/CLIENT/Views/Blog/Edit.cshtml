@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <h2 class="mb-4 text-center">Chỉnh sửa bài viết</h2>

        <div id="responseMessage"></div>

        <form id="editPostForm">
            <input type="hidden" id="postId" value="@ViewBag.PostId">
            <div class="mb-3">
                <label for="title" class="form-label">Tiêu đề</label>
                <input type="text" class="form-control" id="title" required>
            </div>
            <div class="mb-3">
                <label for="content" class="form-label">Nội dung</label>
                <textarea class="form-control" id="content" rows="4" required></textarea>
            </div>
            <div class="d-flex justify-content-between">
                <a href="/Blog" class="btn btn-secondary">Quay lại</a>
                <button type="submit" class="btn btn-primary">Cập nhật</button>
            </div>
        </form>
    </div>
</div>

<script>
    $(document).ready(function () {
        let postId = $("#postId").val();
        
        var accessToken = sessionStorage.getItem('accessToken');
        // Load dữ liệu bài viết
        $.ajax({
            url: `https://localhost:57954/api/Posts/${postId}`,
            type: "GET",
            headers: { 'Authorization': 'Bearer ' + accessToken },
            success: function (data) {
                $("#title").val(data.title);
                $("#content").val(data.content);
            },
            error: function () {
                $("#responseMessage").html('<div class="alert alert-danger">Không thể tải bài viết.</div>');
            }
        });

        // Xử lý cập nhật bài viết
        $("#editPostForm").submit(function (event) {
            event.preventDefault();

            let title = $("#title").val().trim();
            let content = $("#content").val().trim();

            if (title === "" || content === "") {
                $("#responseMessage").html('<div class="alert alert-danger">Tiêu đề và nội dung không được để trống.</div>');
                return;
            }

            $.ajax({
                url: `https://localhost:57954/api/Posts/${postId}`,
                type: "PUT",
                headers: { 'Authorization': 'Bearer ' + accessToken },
                contentType: "application/json",
                data: JSON.stringify({ title: title, content: content, id: postId }),
                success: function () {
                    $("#responseMessage").html('<div class="alert alert-success">Cập nhật thành công!</div>');
                },
                error: function () {
                    console.log("Sending data:", JSON.stringify({ title: title, content: content, id: postId }));
                    $("#responseMessage").html('<div class="alert alert-danger">Có lỗi xảy ra.</div>');
                }
            });
        });
    });
</script>